NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://localhost:27017/wall-paint-visualizer
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:4200
MAX_UPLOAD_MB=10
# Where uploaded images are stored in development (default: server/uploads)
UPLOAD_DIR=
# How long private image links stay valid, in seconds
FILE_URL_TTL_SECONDS=3600

# Seed admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@swpv.local
ADMIN_PASSWORD=ChangeMe123!

# Secret for signing private image links (defaults to one derived from JWT_SECRET)
FILE_URL_SECRET=

# Image storage: "local" (disk, development) or "s3" (production).
# Leave empty to use s3 automatically when AWS_S3_BUCKET is set.
STORAGE_DRIVER=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN/base URL for public catalogue assets (bucket "public/" prefix)
PUBLIC_ASSET_BASE_URL=
